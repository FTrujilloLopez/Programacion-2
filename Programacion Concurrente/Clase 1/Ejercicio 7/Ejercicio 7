programa Ejercicio7
procesos
  proceso recorrerCalle(E calle: numero; ES flores: numero; ES papeles: numero)
  comenzar
    Pos(1,calle)
    flores:= 0
    papeles:= 0
    mientras(PosAv < 100)
      mientras(HayFlorEnLaEsquina)
        tomarFlor
        flores:= flores + 1
      mientras(HayPapelEnLaEsquina)
        tomarPapel
        papeles:= papeles + 1
      mover 
      mientras(HayFlorEnLaEsquina)
        tomarFlor
        flores:= flores + 1
      mientras(HayPapelEnLaEsquina)
        tomarPapel
        papeles:= papeles + 1
  fin
  
  proceso depositarFloresCalle(E calle:numero)
  comenzar
    Pos(1,calle)
    mientras(PosAv < 100)
      depositarFlor
      mover
    depositarFlor
  fin
   
  proceso depositarPapelesCalle(E calle:numero)
  comenzar
    Pos(1,calle)
    mientras(PosAv < 100)
      depositarPapel
      mover
    depositarPapel
  fin
areas
  ciudad: AreaC (1,1,100,100)
robots
  robot robot1
  variables
    flores:numero
    papeles:numero
    calle:numero
    cantCalles:numero
    cantCallesFlores:numero
  comenzar
    derecha
    calle:= 1
    cantCallesFlores:=0
    mientras(calle <= 100)
      recorrerCalle(calle,flores,papeles)
      si(flores >= papeles)
        depositarFloresCalle(calle)
        cantCallesFlores:= cantCallesFlores + 1
      sino
        depositarPapelesCalle(calle)
      calle:= calle + 1   
      
    Informar(cantCallesFlores)     
  fin
variables
  R_info: robot1
comenzar
  AsignarArea(R_info, ciudad)
  Iniciar(R_info, 1,1)
fin