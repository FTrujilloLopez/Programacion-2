programa Ejercicio6
procesos
  proceso recorrerCalle(E calle:numero; ES flores:numero;  ES papeles:numero)
  comenzar
    Pos(1,calle)
    papeles := 0
    flores := 0
    mientras(PosAv < 100)
      mientras(HayFlorEnLaEsquina | HayPapelEnLaEsquina)
        si(HayPapelEnLaEsquina)
          tomarPapel
          papeles:= papeles + 1
        si(HayFlorEnLaEsquina)  
          tomarFlor
          flores:= flores + 1
      mover     
    mientras(HayFlorEnLaEsquina | HayPapelEnLaEsquina)
      si(HayPapelEnLaEsquina)
        tomarPapel
        papeles:= papeles + 1
      si(HayFlorEnLaEsquina)  
        tomarFlor
        flores:= flores + 1
  fin
areas
  ciudad: AreaC (1,1,100,100)
robots
  robot robot1
  variables
    papeles:numero 
    totalPapeles:numero
    flores:numero
    totalFlores:numero
    calle:numero
  comenzar
    derecha
    totalFlores:=0
    totalPapeles:=0
    calle:= 1
    mientras(calle <= 100)
      recorrerCalle(calle,flores,papeles)
      totalFlores:=totalFlores + flores
      totalPapeles:=totalPapeles + papeles
      calle:= calle + 1
    Informar(totalFlores)
    Informar(totalPapeles)
  fin
variables
  R_info: robot1
comenzar
  AsignarArea(R_info, ciudad)
  Iniciar(R_info, 1,1)
fin