programa Ejercicio5B

procesos
  proceso calleFlor(E calle: numero; E flores: numero)
  variables
    cant: numero
  comenzar
    cant := 0
    Pos(1, calle)
    derecha  
    
    mientras (cant < flores) & (PosAv < 100)
      mientras (HayFlorEnLaEsquina)
        tomarFlor
        cant := cant + 1
      mover
      
    { Verificación de la última esquina (avenida 100) }
    mientras (cant < flores) & (HayFlorEnLaEsquina)
      tomarFlor
      cant := cant + 1
      
    Informar(cant)
  fin

areas
  ciudad: AreaC (1, 1, 100, 100)

robots
  robot robot1
  comenzar
    calleFlor(3, 5)
  fin

variables
  R_info: robot1

comenzar
  AsignarArea(R_info, ciudad)
  Iniciar(R_info, 1, 1)
fin