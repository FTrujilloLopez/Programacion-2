programa Ejercicio1
procesos
  proceso recorrerAvenida
  variables 
    cantEsquinas:numero
    cantFlores:numero
  comenzar
    cantEsquinas:=0
    cantFlores:=0
    repetir 99
      si(HayFlorEnLaEsquina) 
        mientras(HayFlorEnLaEsquina)
          tomarFlor 
          cantFlores:=cantFlores + 1
      sino 
        cantEsquinas:=cantEsquinas + 1
      mover
    
    repetir cantFlores
      depositarFlor
  fin
areas
  ciudad1: AreaP (1,1,1,100)
  ciudad2: AreaP (3,1,3,100)
  ciudad3: AreaP (5,1,5,100)
robots
  robot robot1
  comenzar
    recorrerAvenida
  fin
  robot robot2
  comenzar
    recorrerAvenida
  fin
  robot robot3
  comenzar
    recorrerAvenida
  fin
variables
  R1: robot1
  R2: robot2
  R3: robot3
comenzar
  AsignarArea(R1, ciudad1)
  AsignarArea(R2, ciudad2)
  AsignarArea(R3, ciudad3)
  Iniciar(R1, 1,1)
  Iniciar(R2, 3,1)
  Iniciar(R3, 5,1)        
  
   
fin